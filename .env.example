# Build-time Public Variables (passed to docker build / CodeBuild)
# Optional and deprecated: the build no longer needs it. Kept only as a fallback for
# STRAPI_PUBLIC_URL / STRAPI_ADMIN_URL until the pipeline build arg is removed.
NEXT_PUBLIC_STRAPI_URL=https://your-strapi-url.com
# Server-side Runtime Variables (Should be in ECS Task Definition / Render Env)
# Where the Next server calls Strapi. Server-only, read at runtime, never sent to the
# browser. Set to the internal ALB / ECS Service Connect address once Strapi is private
# (falls back to STRAPI_URL during rollout).
STRAPI_INTERNAL_URL=http://strapi.internal:1337
# Optional. Public prefix for relative Strapi media URLs (/uploads/...). Not needed with
# the S3 upload provider, which returns absolute URLs. Do NOT set it to the internal URL.
STRAPI_PUBLIC_URL=
# Optional. Origin editors use for Strapi Admin (/admin), allowed in CSP frame-ancestors
# for the content preview. Falls back to STRAPI_PUBLIC_URL, then NEXT_PUBLIC_STRAPI_URL.
STRAPI_ADMIN_URL=https://cms-admin.example.com
BRANCH_MASTER_BASE_URL=https://your-branch-master-url.com
BRANCH_MASTER_JWT_TOKEN=your_jwt_token_here
BRANCH_MASTER_TOKEN=your_token_here
CHANNEL_LEAD_TOKEN=your_channel_lead_token
CRM_TOKEN=your_crm_token
GOLD_QUOTE_BASE_URL=https://your-gold-quote-url.com
# Feature flag to enable live gold quote API and calculator features (set to true to enable)
GOLD_QUOTE_ENABLED=false

CHANNEL_LEAD_USERNAME=your_channel_lead_username
CHANNEL_LEAD_PASSWORD=your_channel_lead_password
BRANCH_MASTER_USERNAME=your_branch_master_username
BRANCH_MASTER_PASSWORD=your_branch_master_password
CRM_USERNAME=your_crm_username
CRM_PASSWORD=your_crm_password
CRM_AUTH_URL=your_crm_auth_url
CHANNEL_AUTH_URL=your_channel_auth_url
OTP_SESSION_SECRET=your_32_byte_secret_here
INTERNAL_API_SECRET=your_shared_secret
STRAPI_SUBMISSION_TOKEN=your_strapi_custom_token

# Google Tag Manager Container ID (starts with GTM-, found in GTM workspace header)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID (starts with G-, found in GA4 Admin -> Data Streams -> Web Stream)
# (Only needed if NOT loading GA4 via GTM)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


